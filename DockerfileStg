# stg 专用构建：docker buildx build -f DockerfileStg --platform=linux/arm64 ...
# 最终运行镜像基于国产操作系统 Kylin Server V10（arm64），必须使用 --platform=linux/arm64 构建。
FROM swr.cofco-cn-beijing-1.cofco.com/liangdawang-test-liangdawang/bun:1.4.0-arm64 AS builder

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
ARG BUN_INSTALL_NETWORK_CONCURRENCY=16
RUN bun install --frozen-lockfile --network-concurrency="${BUN_INSTALL_NETWORK_CONCURRENCY}"
COPY ./web ./
COPY ./VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM swr.cofco-cn-beijing-1.cofco.com/liangdawang-test-liangdawang/golang:1.26.1-alpine-arm64 AS builder2
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-arm64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
# relaykit is a local submodule referenced via replace; its go.mod must be
# present for go mod download to resolve the main module graph.
ADD relaykit/go.mod ./relaykit/go.mod
RUN go mod download

COPY . .
COPY --from=builder /build/web/dist ./web/dist
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM swr.cofco-cn-beijing-1.cofco.com/public/kylin-server-10-arm64:latest

# Kylin Server V10 基础镜像已内置 ca-certificates 与 tzdata；stg 走 K8s（探针用 httpGet），
# 不需要 wget；new-api 为 CGO_ENABLED=0 静态二进制，运行时不依赖 libasan。
# 构建环境无法访问 Kylin yum 仓库，故不做包安装，仅离线刷新 CA 证书。
RUN update-ca-trust

COPY --from=builder2 /build/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
