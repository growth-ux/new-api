# 使用 --platform=linux/arm64 构建，运行环境为 Kylin Server V10。
FROM swr.cofco-cn-beijing-1.cofco.com/liangdawang-test-liangdawang/new-api-web-deps:v1 AS builder
WORKDIR /build/web
COPY ./web ./
RUN bun --bun run build

FROM swr.cofco-cn-beijing-1.cofco.com/liangdawang-test-liangdawang/new-api-go-deps:v1 AS builder2
ENV GOPROXY=off
WORKDIR /build
COPY . .
COPY --from=builder /build/web/dist ./web/dist
RUN go build -mod=readonly -ldflags "-s -w" -o new-api

FROM swr.cofco-cn-beijing-1.cofco.com/public/kylin-server-10-arm64:latest
COPY --from=builder2 /build/new-api /
WORKDIR /data
ENTRYPOINT ["/new-api"]
