# Use musl to avoid the newer glibc thread-creation path on legacy Docker hosts.
# Reinstall dependencies here so native packages match musl (not glibc).
FROM oven/bun:1.4.0-alpine AS web-deps

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile --network-concurrency=16


FROM golang:1.26.1-alpine AS go-deps

ENV CGO_ENABLED=0 GOWORK=off GOTOOLCHAIN=local GOOS=linux GOARCH=amd64

WORKDIR /build
COPY go.mod go.sum ./
# relaykit is a local submodule referenced via replace.
COPY relaykit/go.mod relaykit/go.sum ./relaykit/
RUN go mod download \
    && find /go/pkg/mod/cache/download -type f -name '*.zip' -delete
